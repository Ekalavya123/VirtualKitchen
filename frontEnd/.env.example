# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of the Spring Boot backend.
VITE_API_BASE_URL=http://localhost:8080

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs > Web application).
# Must match the backend's google.oauth.client-id / GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=855031822848-1mrvbt41g8h1rotg24s89pokom0nt5c8.apps.googleusercontent.com
